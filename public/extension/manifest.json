{
  "manifest_version": 3,
  "name": "Sovereign — AI Candidate & Proposal Intelligence",
  "version": "1.4.0",
  "description": "Proposal engine, tailored CVs, and match scores for the open job — never the feed. Never auto-submits.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Analyze Page with Sovereign",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["scraper.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
