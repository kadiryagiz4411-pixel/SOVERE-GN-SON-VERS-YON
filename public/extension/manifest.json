{
  "manifest_version": 3,
  "name": "Sovereign — AI Candidate & Proposal Intelligence",
  "version": "1.2.0",
  "description": "One-click DOM scraper, rational candidate evaluator, and natural proposal generator for Upwork and LinkedIn.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.upwork.com/*",
    "https://*.indeed.com/*",
    "https://www.sovereignapp.pro/*",
    "https://sovereignapp.pro/*",
    "https://*.sovereignapp.pro/*",
    "https://*.vercel.app/*",
    "https://*.sovereign.app/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Analyze Page with Sovereign",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
