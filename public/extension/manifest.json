{
  "manifest_version": 3,
  "name": "Sovereign — AI Candidate & Proposal Intelligence",
  "version": "1.1.0",
  "description": "One-click DOM scraper, rational candidate evaluator, and natural proposal generator for Upwork and LinkedIn.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.upwork.com/*",
    "https://*.indeed.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Analyze Page with Sovereign"
  }
}
