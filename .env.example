# ═══════════════════════════════════════════════════════════════════════════════
#  Sovereign AI — Environment Variables Reference
#  Copy this file to .env and fill in your values before running the app.
#  Variables prefixed with VITE_ are bundled into the frontend build.
#  Do NOT commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found at: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>
# Alias accepted by older code paths — same value as VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>

# ── OpenAI (BYOK / Admin key) ─────────────────────────────────────────────────
# Used as a client-side fallback when the Edge Function is unavailable.
# NEVER expose a production key here for anonymous users.
# For a fully-serverless setup, leave this blank and handle the key server-side.
VITE_OPENAI_API_KEY=

# ── Edge Function slug override ───────────────────────────────────────────────
# Default slug is "sovereign". Override if your project uses a different name.
VITE_EDGE_CV_FUNCTION=sovereign

# ── Lemon Squeezy Store ───────────────────────────────────────────────────────
# Your store base URL (no trailing slash).
VITE_LEMONSQUEEZY_STORE_URL=https://sovereignapp.lemonsqueezy.com

# ── Lemon Squeezy Variant IDs ────────────────────────────────────────────────
# Found in: Lemon Squeezy → Products → <Plan> → Variants → ID column
VITE_STANDARD_MONTHLY_VARIANT_ID=
VITE_STANDARD_YEARLY_VARIANT_ID=
VITE_PRO_MONTHLY_VARIANT_ID=
VITE_PRO_YEARLY_VARIANT_ID=
VITE_ELITE_MONTHLY_VARIANT_ID=
VITE_ELITE_YEARLY_VARIANT_ID=

# ── Lemon Squeezy Full Checkout URLs (optional override) ─────────────────────
# Use these to bypass variant-ID-based URL construction.
# Format: https://sovereignapp.lemonsqueezy.com/checkout/buy/<variant-uuid>
#         You can append ?checkout[custom][user_id]=<user_id>&checkout[email]=<email>
#         to pre-fill the checkout and link purchases back to the user account.
#
# One-time pass
VITE_LEMONSQUEEZY_ONETIME_PASS_URL=

# Tier 1 — Standard ($12/mo · $9/mo annual)
VITE_LEMONSQUEEZY_STANDARD_MONTHLY_URL=
VITE_LEMONSQUEEZY_STANDARD_ANNUAL_URL=

# Tier 2 — Pro / B2B ($29/mo · $22/mo annual)
VITE_LEMONSQUEEZY_PRO_MONTHLY_URL=
VITE_LEMONSQUEEZY_PRO_ANNUAL_URL=

# Tier 3 — Elite / Unlimited Agency ($59/mo · $45/mo annual)
VITE_LEMONSQUEEZY_ELITE_MONTHLY_URL=
VITE_LEMONSQUEEZY_ELITE_ANNUAL_URL=

# Tier 4 — Enterprise B2B ($299/mo · $239/mo annual)
VITE_LEMONSQUEEZY_ENTERPRISE_MONTHLY_URL=
VITE_LEMONSQUEEZY_ENTERPRISE_ANNUAL_URL=

# ── Post-checkout redirect ────────────────────────────────────────────────────
# Append ?redirect_url=... to each Lemon Squeezy checkout URL so users land here
# after a successful purchase. The dashboard detects ?payment=success and shows
# a celebratory confirmation toast.
#
# Example redirect for Standard Monthly:
#   https://sovereignapp.lemonsqueezy.com/checkout/buy/<variant-id>
#     ?checkout[redirect_url]=https://sovereignapp.pro/dashboard?payment=success
#
# For AppSumo licence redemption:
#   ?checkout[redirect_url]=https://sovereignapp.pro/redeem
