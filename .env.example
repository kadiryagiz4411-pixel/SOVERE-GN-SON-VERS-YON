# ═══════════════════════════════════════════════════════════════════════════════
#  Sovereign AI — Environment Variables Reference
#  Copy this file to .env and fill in your values before running the app.
#  Variables prefixed with VITE_ are bundled into the frontend build.
#  Do NOT commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found at: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>
# Alias accepted by older code paths — same value as VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>

# ── OpenAI (BYOK / Admin key) ─────────────────────────────────────────────────
# Used as a client-side fallback when the Edge Function is unavailable.
# NEVER expose a production key here for anonymous users.
# For a fully-serverless setup, leave this blank and handle the key server-side.
VITE_OPENAI_API_KEY=

# ── Edge Function slug override ───────────────────────────────────────────────
# Default slug is "sovereign". Override if your project uses a different name.
VITE_EDGE_CV_FUNCTION=sovereign

# ── Polar.sh (Stripe-backed merchant of record) ──────────────────────────────
# Server-only (Vercel / api/billing/*). Never prefix these with VITE_.
# Checkout is minted by POST /api/billing/checkout. Success returns to
# https://sovereignapp.pro/dashboard?payment=success&checkout_id={CHECKOUT_ID}
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=production
POLAR_CUSTOMER_PORTAL_URL=

POLAR_PRODUCT_STANDARD_MONTHLY=
POLAR_PRODUCT_STANDARD_ANNUAL=
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_ANNUAL=
POLAR_PRODUCT_ELITE_MONTHLY=
POLAR_PRODUCT_ELITE_ANNUAL=
POLAR_PRODUCT_ENTERPRISE_MONTHLY=
POLAR_PRODUCT_ENTERPRISE_ANNUAL=
POLAR_PRODUCT_SINGLE_PASS=

# Optional price-id aliases (same Polar product or price IDs)
POLAR_PRICE_STANDARD_MONTHLY=
POLAR_PRICE_STANDARD_ANNUAL=
POLAR_PRICE_PRO_MONTHLY=
POLAR_PRICE_PRO_ANNUAL=
POLAR_PRICE_ELITE_MONTHLY=
POLAR_PRICE_ELITE_ANNUAL=
POLAR_PRICE_ENTERPRISE_MONTHLY=
POLAR_PRICE_ENTERPRISE_ANNUAL=
POLAR_PRICE_SINGLE_PASS=

# Server-only database key for webhooks and billing fulfillment
SUPABASE_SERVICE_ROLE_KEY=
