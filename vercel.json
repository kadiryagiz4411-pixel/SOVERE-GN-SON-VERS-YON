{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.sovereignapp.pro" }],
      "destination": "https://sovereignapp.pro/:path*",
      "permanent": true
    },
    { "source": "/checkout", "destination": "/pricing", "permanent": true },
    { "source": "/checkout/:path*", "destination": "/pricing", "permanent": true },
    { "source": "/buy/:path*", "destination": "/pricing", "permanent": true },
    { "source": "/redeem", "destination": "/pricing", "permanent": true },
    { "source": "/cvbuilder", "destination": "/cv-builder", "permanent": true },
    { "source": "/cv", "destination": "/cv-builder", "permanent": false }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__route=:path*" },
    { "source": "/cv-builder", "destination": "/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-extension-id, x-sovereign-key, Cache-Control, Pragma, Accept, X-Requested-With, Origin" },
        { "key": "Vary", "value": "Origin, Access-Control-Request-Method, Access-Control-Request-Headers" },
        { "key": "Access-Control-Max-Age", "value": "86400" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/api/opportunities",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
